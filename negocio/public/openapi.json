{
  "openapi": "3.0.3",
  "info": {
    "title": "Negocio API",
    "version": "1.0.0",
    "description": "OpenAPI definition for the negocio Slim API.",
    "contact": {
      "name": "ProyectoPrep",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor del Api en desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "cliente": {
        "type": "object",
        "additionalProperties": true,
        "description": "Cliente payload forwarded to the backend service."
      },
      "mecanico": {
        "type": "object",
        "additionalProperties": true,
        "description": "Mecanico payload forwarded to the backend service."
      },
      "login": {
        "type": "object",
        "properties": {
          "cedula": { "type": "string", "example": "12345678" },
          "passw": { "type": "string", "example": "password123" }
        },
        "required": ["cedula", "passw"]
      },
      "changePassword": {
        "type": "object",
        "properties": {
          "passw": { "type": "string", "example": "oldPassword" },
          "passwN": { "type": "string", "example": "newPassword" }
        },
        "required": ["passw", "passwN"]
      },
      "changeRole": {
        "type": "object",
        "properties": {
          "rol": { "type": "string", "example": "admin" }
        },
        "required": ["rol"]
      },
      "tokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "example": 3600 }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    { "name": "Cliente", "description": "Operations related to clientes" },
    { "name": "Mecanico", "description": "Operations related to mecanicos" },
    { "name": "Auth", "description": "Authentication and user management operations" },
    { "name": "Usuario", "description": "Operations related to usuarios" }
  ],
  "paths": {
    "/api/cliente": {
      
      "get": {
        "summary": "List clientes",
        "tags": ["Cliente"],
        "description": "Returns all clientes or a filtered list.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": { "type": ["array", "object"] }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create cliente",
        "tags": ["Cliente"],
        "requestBody": {
          "description": "Cliente object to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/cliente" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created cliente",
            "content": { "application/json": { "schema": { "type": ["array", "object"] } } }
          }
        }
      }
    },
    "/api/cliente/{id}": {
      "get": {
        "summary": "Get cliente by ID",
        "tags": ["Cliente"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Cliente found", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "description": "Cliente not found" }
        }
      },
      "put": {
        "summary": "Update cliente",
        "tags": ["Cliente"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "description": "Cliente object to update",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/cliente" } } }
        },
        "responses": {
          "200": { "description": "Cliente updated" }
        }
      },
      "delete": {
        "summary": "Delete cliente",
        "tags": ["Cliente"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "Cliente deleted" } }
      }
    },
    "/api/cliente/filter/{pag}/{lim}": {
      "get": {
        "summary": "Filter clientes",
        "tags": ["Cliente"],
        "parameters": [
          { "name": "pag", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "lim", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Filtered cliente list", "content": { "application/json": { "schema": { "type": ["array", "object"] } } } }
        }
      }
    },
    "/api/mecanico": {
      "get": {
        "summary": "List mecanicos",
        "tags": ["Mecanico"],
        "responses": {
          "200": { "description": "Successful response", "content": { "application/json": { "schema": { "type": ["array", "object"] } } } }
        }
      },
      "post": {
        "summary": "Create mecanico",
        "tags": ["Mecanico"],
        "requestBody": {
          "description": "Mecanico object to create",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/mecanico" } } }
        },
        "responses": {
          "200": { "description": "Created mecanico" }
        }
      }
    },
    "/api/mecanico/{id}": {
      "get": {
        "summary": "Get mecanico by ID",
        "tags": ["Mecanico"],   
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Mecanico found", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "description": "Mecanico not found" }
        }
      },
      "put": {
        "summary": "Update mecanico",
        "tags": ["Mecanico"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "description": "Mecanico object to update",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/mecanico" } } }
        },
        "responses": { "200": { "description": "Mecanico updated" } }
      },
      "delete": {
        "summary": "Delete mecanico",
        "tags": ["Mecanico"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "204": { "description": "Mecanico deleted" } }
      }
    },
    "/api/mecanico/filter/{pag}/{lim}": {
      "get": {
        "summary": "Filter mecanicos",
        "tags": ["Mecanico"],
        "parameters": [
          { "name": "pag", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "lim", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Filtered mecanico list", "content": { "application/json": { "schema": { "type": ["array", "object"] } } } }
        }
      }
    },
    "/api/auth": {
      "patch": {
        "summary": "Login",
        "tags": ["Auth"],
        "description": "Authenticate and receive a JWT token.",
        "security": [],
        "requestBody": {
          "description": "Login credentials",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/login" } } }
        },
        "responses": {
          "200": { "description": "Authentication successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/tokenResponse" } } } },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/logout/{id}": {
      "patch": {
        "summary": "Logout user",
        "tags": ["Auth"],
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Logout successful" },
          "401": { "description": "Logout failed" }
        }
      }
    },
    "/api/usuario/passw/{id}": {
      "patch": {
        "summary": "Change user password",
        "tags": ["Usuario"],
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "description": "Old and new password values",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/changePassword" } } }
        },
        "responses": {
          "200": { "description": "Password changed" },
          "401": { "description": "Authentication failed" }
        }
      }
    },
    "/api/usuario/passw/reset/{id}": {
      "patch": {
        "summary": "Reset user password",
        "tags": ["Usuario"],
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Password reset" },
          "401": { "description": "Request failed" }
        }
      }
    },
    "/api/usuario/rol/{id}": {
      "patch": {
        "summary": "Change user role",
        "tags": ["Usuario"],
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "description": "New user role",
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/changeRole" } } }
        },
        "responses": {
          "200": { "description": "Role changed" },
          "401": { "description": "Request failed" }
        }
      }
    },
    "/api/usuario/buscar/{id}": {
      "get": {
        "summary": "Find user by ID",
        "tags": ["Usuario"],
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User found", "content": { "application/json": { "schema": { "type": "object" } } } },
          "404": { "description": "User not found" }
        }
      }
    }
  }
}
